{
    "name": "song-nexus",
    "version": "1.0.1",
    "private": true,
    "description": "Full-stack Musikplattform. Dieses Paket startet nur Backend und Frontend gemeinsam; die eigentlichen Abhängigkeiten liegen in backend/ und frontend/.",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"blue.bold,magenta.bold\" \"npm run server:local\" \"npm run client\"",
        "start": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"blue.bold,magenta.bold\" \"npm run server:local\" \"npm run client\"",
        "start:prod": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"blue.bold,magenta.bold\" \"npm run server:prod\" \"npm run client\"",
        "server:local": "cd backend && npm run start:local",
        "server:prod": "cd backend && npm run start:prod",
        "server:watch": "cd backend && npm run dev:local",
        "client": "cd frontend && npm start",
        "build": "cd frontend && npm run build",
        "build:dev": "cd frontend && npm run build:dev",
        "test": "cd backend && npm test",
        "audit:all": "cd backend && npm audit && cd ../frontend && npm audit",
        "install:all": "npm install && cd backend && npm ci && cd ../frontend && npm ci",
        "seed:dev-admin": "cd backend && npm run seed:dev-admin"
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    }
}
