# ============================================================================
# VORLAGE - enthaelt absichtlich KEINE echten Werte
# ============================================================================
#
# Diese Datei liegt im oeffentlichen Repository. Jeder echte Wert hier ist
# oeffentlich. Bis zum 15.08.2026 standen hier tatsaechlich funktionierende
# Secrets (Issue #2) - die wurden entfernt und rotiert.
#
# So gehst du vor:
#   1. Secrets generieren:  .\scripts\generate-secrets.ps1
#   2. Datei nach .env.production kopieren (wird von .gitignore erfasst)
#   3. Werte eintragen - NIEMALS in diese .example-Datei
#
# Jedes Secret braucht einen EIGENEN Wert. Zuvor waren JWT_SECRET und
# SESSION_SECRET identisch; server.js verweigert das jetzt in Produktion.
# ============================================================================

# ========== ENVIRONMENT ==========
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# ========== FRONTEND CONFIG ==========
FRONTEND_URL=https://DEINE-DOMAIN.at
ALLOWED_ORIGINS=https://DEINE-DOMAIN.at
API_BASE=https://DEINE-DOMAIN.at/api

# ========== DATABASE CONFIG ==========
DB_HOST=localhost
DB_PORT=5432
DB_NAME=song_nexus_prod
DB_USER=song_nexus_user
DB_PASSWORD=<starkes-DB-Passwort-hier-einsetzen>
DB_SSL=true

# ========== AUTH CONFIG ==========
JWT_SECRET=<openssl rand -base64 32>
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=<openssl rand -base64 32 – EIGENER Wert!>
BCRYPT_ROUNDS=10

# ========== WEBAUTHN CONFIG ==========
WEBAUTHN_RP_ID=DEINE-DOMAIN.at
WEBAUTHN_RP_NAME=SONG-NEXUS
WEBAUTHN_ORIGIN=https://DEINE-DOMAIN.at
WEBAUTHN_TIMEOUT=60000

# ========== HTTPS CERTS (nginx terminiert TLS) ==========
CERT_PATH=
KEY_PATH=
USE_HTTPS=false   # hinter nginx: false, nginx terminiert TLS

# ========== CSRF & COOKIES ==========
COOKIE_SECRET=<openssl rand -base64 32 – EIGENER Wert!>
CSRF_TOKEN_LENGTH=32

# ========== PAYPAL CONFIG ==========
PAYPAL_CLIENT_ID=<PayPal LIVE Client-ID>
PAYPAL_CLIENT_SECRET=<PayPal LIVE Secret>
PAYPAL_MODE=live

# ========== UPLOAD CONFIG ==========
UPLOAD_DIR=./backend/public/audio
MAX_FILE_SIZE=104857600

# ========== LOGGING CONFIG ==========
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ========== SECURITY CONFIG ==========
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=30
RATE_LIMIT_STREAM_WINDOW_MS=60000
RATE_LIMIT_STREAM_MAX=50

HSTS_MAX_AGE=31536000
TRUST_PROXY=true

# ========== MAGIC LINK CONFIG ==========
MAGIC_LINK_EXPIRY_MINUTES=15
MAGIC_LINK_TOKEN_LENGTH=32

# ========== SESSION CONFIG ==========
SESSION_SECRET=<openssl rand -base64 32 – EIGENER Wert!>
SESSION_MAX_AGE=900000

# ========== DATABASE SOFT-DELETE CONFIG ==========
SOFT_DELETE_ENABLED=true
