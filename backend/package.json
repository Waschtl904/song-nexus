{
  "name": "song-nexus-backend",
  "version": "6.2.0",
  "description": "Production Backend for SONG-NEXUS with PayPal integration and HTTPS support",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --no-deprecation server.js",
    "dev": "nodemon --no-deprecation server.js --ignore logs",
    "start:local": "cross-env NODE_ENV=development node --no-deprecation server.js",
    "start:prod": "cross-env NODE_ENV=production node --no-deprecation server.js",
    "dev:local": "cross-env NODE_ENV=development nodemon --no-deprecation server.js --ignore logs",
    "seed:dev-admin": "node scripts/seed-dev-admin.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:handles": "jest --runInBand --detectOpenHandles",
    "test:ci": "jest --runInBand --ci",
    "generate-cert": "node generate-cert.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/__tests__/setup.js"
    ],
    "verbose": true,
    "collectCoverageFrom": [
      "routes/**/*.js"
    ]
  },
  "author": "Waschtl904",
  "license": "MIT",
  "dependencies": {
    "@paypal/checkout-server-sdk": "^1.0.3",
    "@simplewebauthn/server": "^13.2.2",
    "axios": "^1.6.0",
    "base64url": "^3.0.1",
    "bcryptjs": "^2.4.3",
    "cbor": "^10.0.11",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "express-validator": "^7.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.0",
    "mongo-sanitize": "^1.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^9.0.5",
    "pg": "^8.16.3",
    "rotating-file-stream": "^3.2.7"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "node-forge": "^1.3.3",
    "nodemon": "^3.0.1",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
