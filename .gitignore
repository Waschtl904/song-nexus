# ============================================================================
# ENVIRONMENT FILES - NEVER COMMIT SECRETS!
# ============================================================================
.env
.env.local
.env.*.local
.env.production
.env.production.local
.env.staging
.env.development
# Ausnahme: die Vorlagen sollen versioniert werden
!.env.example
!.env.production.example
!*/.env.example

# Sonstige Geheimnistraeger
*.pem
*.key
!backend/certs/localhost*.pem
!frontend/certs/localhost*.pem
secrets/

# Ausgabe von scripts/generate-secrets.ps1
# Das Muster *-secrets.txt allein greift NICHT bei "secrets-neu.txt" - genau so
# lag die Datei mit den Live-Secrets ungeschuetzt im Arbeitsverzeichnis und
# waere bei einem "git add ." mitgegangen.
secrets-neu.txt
secrets*.txt
*secrets*.txt
*-secrets.txt
*.secrets

# Backend ENV
backend/.env
backend/.env.local

# ============================================================================
# NODE MODULES & PACKAGE MANAGERS
# ============================================================================
node_modules/
npm-debug.log
npm-error.log
yarn-error.log
# package-lock.json   <- bewusst NICHT ignoriert (npm ci in CI braucht die Lockfile)
# yarn.lock   <- bewusst NICHT ignoriert (npm ci in CI braucht die Lockfile)
# pnpm-lock.yaml   <- bewusst NICHT ignoriert (npm ci in CI braucht die Lockfile)

# ============================================================================
# LOGS & TEMPORARY FILES
# ============================================================================
logs/
*.log
app.log
*.tmp

# ============================================================================
# UPLOADS & GENERATED FILES
# ============================================================================
# Wird bei JEDEM webpack-Lauf neu geschrieben: webpack.config.js:291 ruft
# runDesignSystemLoader() beim Auswerten der Konfiguration auf, und die
# Funktion schreibt nach frontend/styles/, also in den Quellbaum.
# Die Datei ist damit ein Bauartefakt, kein Quelltext. Versioniert war sie
# nur solange stillhaltend, wie die eingecheckte Fassung zufaellig dem
# entsprach, was der Build erzeugt - eine Uebereinstimmung, die niemand
# geprueft hat. Massgeblich ist frontend/config/design.config.json.
# Siehe Issue #66.
frontend/styles/_design-tokens.css

uploads/
backend/public/audio/*.mp3
backend/public/audio/*.wav
backend/public/audio/*.m4a
backend/public/audio/*.flac
# Keep directory structure:
!backend/public/audio/.gitkeep

# ============================================================================
# BACKUPS & TEMPORARY
# ============================================================================
*.backup
*.old
*.bak
*~
# Handsicherungen wie package.json.alt. Standen bisher als unversionierte
# Dateien in git status und haetten bei einem "git add ." mitgehen koennen.
*.alt

# ============================================================================
# DATABASE CREDENTIALS (CRITICAL!)
# ============================================================================
backend/db.js
backend/database.js

# ============================================================================
# IDE & EDITOR
# ============================================================================
.vscode/
.idea/
*.swp
*.swo
*.swn
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
.project
.classpath

# ============================================================================
# OS FILES
# ============================================================================
.DS_Store
Thumbs.db
.Spotlight-V100
.Trashes
ehthumbs.db

# ============================================================================
# BUILD OUTPUT
# ============================================================================
dist/
build/
.next/
out/

# ============================================================================
# OPTIONAL: SSL CERTIFICATES (PRODUCTION ONLY)
# ============================================================================
# ✅ DEVELOPMENT: mkcert certs ARE included (they're safe!)
# ✅ backend/certs/localhost.pem - INCLUDE for dev
# ✅ backend/certs/localhost-key.pem - INCLUDE for dev
# ❌ Production certificates - NEVER commit

# Only ignore production/self-signed fallbacks (not mkcert):
# backend/certs/cert.pem
# backend/certs/key.pem

# ============================================================================
# OPTIONAL: COMPILED/TRANSPILED CODE
# ============================================================================
*.tsbuildinfo
dist/
build/

# ============================================================================
# OPTIONAL: COVERAGE & TEST FILES
# ============================================================================
coverage/
.nyc_output/
*.lcov

# ============================================================================
# OPTIONAL: ENVIRONMENT-SPECIFIC
# ============================================================================
.env.development.local
.env.test.local
.env.production.local

# ============================================================================
# WIEDERHERGESTELLT AM 15.08.2026 (Issue #2)
# ============================================================================
# Das Ende dieser Datei war UTF-16-kodiert (angehaengt per PowerShell-Redirect,
# das standardmaessig UTF-16LE schreibt). Git konnte diese Zeilen nicht lesen -
# die Regel fuer .env.production war also vorhanden, aber wirkungslos.
# Datei ist jetzt durchgaengig UTF-8. Beim Anhaengen unter PowerShell bitte:
#     Add-Content -Path .gitignore -Value ".env.xyz" -Encoding utf8
# ============================================================================
.env.test.local
.env.production.local

